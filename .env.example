# Firebase Firestore Configuration
# Option 1: Path to service account JSON key file (e.g., downloaded from Firebase Console)
FIREBASE_CREDENTIALS_PATH=firebase-key.json

# Option 2: Paste the service account JSON directly as a string (ideal for Render/Railway/Fly.io)
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# Flask Configuration
FLASK_SECRET_KEY=roughset_secret_super_key_2024_secure
FLASK_ENV=development
PORT=5005

# Admin Teacher Credentials
ADMIN_USERNAME=Amenallah
# Plaintext fallback in dev if hash is not set, or scrypt/pbkdf2 hash
ADMIN_PASSWORD=Amen1920
ADMIN_PASSWORD_HASH=
